{
  "name": "@careerboard/api-client",
  "version": "0.1.0",
  "description": "Node.js client for the Careerboard Public API.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/careerboard/api-client.git"
  },
  "homepage": "https://github.com/careerboard/api-client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup",
    "sync:generated": "node ./scripts/sync-generated.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
